# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- Banco (Postgres do compose) ---
POSTGRES_DB=cremepe
POSTGRES_USER=cremepe
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Web ---
HTTP_PORT=8080
GUNICORN_WORKERS=4
SECURE_COOKIES=false

# Exige a troca da senha inicial (PrimeiroNome@CPF) no primeiro acesso.
# Em PRODUÇÃO deve ser true. Use false apenas em desenvolvimento/testes.
EXIGIR_TROCA_SENHA=true

# --- Caminhos (dentro dos containers) ---
MEDIA_ROOT=/srv/media
STATIC_ROOT=/app/staticfiles

# --- Regras de progresso ---
PROGRESS_MAX_RATE=1.25
PROGRESS_GRACE_SECONDS=5
SEGMENT_TOLERANCE_SECONDS=12
HEARTBEAT_INTERVAL_SECONDS=10

# --- Upload / mídia ---
UPLOAD_CHUNK_SIZE=16777216
HLS_TOKEN_TTL_SECONDS=28800
API_TOKEN_TTL_SECONDS=28800
HLS_SEGMENT_SECONDS=4
